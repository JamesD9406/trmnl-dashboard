TRMNL_WEBHOOK_URL=https://usetrmnl.com/api/custom_plugins/REPLACE_WITH_YOUR_UUID
FOOTBALL_DATA_API_KEY=REPLACE_WITH_YOUR_FOOTBALL_DATA_ORG_KEY

# Latitude/longitude for weather + sunrise/sunset (this example is Liverpool, UK)
WEATHER_LAT=53.4084
WEATHER_LON=-2.9916

# IANA timezone for displayed times
TIMEZONE=Europe/London

# "celsius" or "fahrenheit"
TEMP_UNIT=celsius

# Drop a team from the sports panel when its next game is more than this many
# days out (its season is over). Optional, default 30.
SPORTS_HORIZON_DAYS=30
